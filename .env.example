# Vercel AI Gateway key (https://vercel.com/docs/ai-gateway). Required for AI analysis.
# Without it, the CLI falls back to a heuristic (non-AI) guide.
AI_GATEWAY_API_KEY=

# Optional: override the model routed through the gateway.
# GUIDED_REVIEW_MODEL=anthropic/claude-sonnet-5.5

# Optional: GitHub auth. By default the `gh` CLI's own login is used.
# GH_TOKEN=
